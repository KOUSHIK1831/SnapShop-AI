# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────
# Neon free tier: DATABASE_URL is the pooled (-pooler) URL,
# DIRECT_URL is the direct URL used for migrations.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TTL=15m
REFRESH_TTL=30d

# ── Storage ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
PUBLIC_MEDIA_URL=http://localhost:4000/media

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_DRIVER=console
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="SnapShop AI <no-reply@snapshop.local>"

# ── Google OAuth (Phase 1) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Seed ──────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@snapshop.local
ADMIN_PASSWORD=ChangeMe123!
