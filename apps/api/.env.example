# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=1

# ── Database (100% Free: Neon Serverless Postgres) ─────────────────────────
# Get free PostgreSQL at https://neon.tech
# DATABASE_URL is the pooled (-pooler) URL for runtime queries
# DIRECT_URL is the direct unpooled URL used for prisma migrations
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/snapshop?sslmode=require
DIRECT_URL=postgresql://user:password@ep-sample.region.neon.tech/snapshop?sslmode=require

# ── Auth & JWT ────────────────────────────────────────────────────────────
# Generate secure keys with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-for-jwt-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-for-jwt-refresh
JWT_ISSUER=snapshop-api
JWT_AUDIENCE=snapshop-web
ACCESS_TTL=15m
REFRESH_TTL=30d
REFRESH_COOKIE_NAME=snapshop_rt
# COOKIE_DOMAIN=.yourdomain.com

# ── Storage (local development or private Supabase Storage S3 bucket) ──────
# Production requires STORAGE_DRIVER=s3. Keep the bucket private.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<region-from-supabase-s3-settings>
# S3_BUCKET=<private-bucket-name>
# S3_ACCESS_KEY_ID=<server-side-s3-access-key>
# S3_SECRET_ACCESS_KEY=<server-side-s3-secret-key>

# ── Email (100% Free: Resend Free Tier 3,000 emails/mo) ───────────────────
# Get free key at https://resend.com
EMAIL_DRIVER=console
# RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="SnapShop AI <no-reply@snapshop.local>"

# ── Google OAuth 2.0 (100% Free Google Cloud Console) ─────────────────────
# Get free credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI Vision & WhatsApp Agent (100% Free Tier: Gemini 2.5 Flash + Groq) ──
# Google AI Studio free key: https://aistudio.google.com/app/apikey
# Groq free key: https://console.groq.com/keys
AI_PROVIDER=auto
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── WhatsApp Cloud API (Meta Webhook) ─────────────────────────────────────
# Free Meta Developer WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=snapshop-meta-verify-token
# WHATSAPP_APP_SECRET=your-meta-app-secret
# WHATSAPP_API_VERSION=v21.0

# ── Observability & Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# ── Seed Admin Account ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@snapshop.local
ADMIN_PASSWORD=replace-with-a-local-only-password
