{
  "name": "snapshop-ai",
  "private": true,
  "version": "0.1.0",
  "description": "SnapShop AI \u2014 full-stack monorepo (React web client + Express API)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @snapshop/api db:generate",
    "db:migrate": "pnpm --filter @snapshop/api db:migrate",
    "db:studio": "pnpm --filter @snapshop/api db:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "apps/api/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
