# ── Supabase Config ─────────────────────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# ── Sentry Config (Error Tracking) ─────────────────────────────────────────
# https://sentry.io/settings/{org}/projects/{project}/keys/
VITE_SENTRY_DSN="https://your-dsn@sentry.io/your-project"
VITE_SENTRY_ENV="development"

# ── PostHog Config (Product Analytics) ─────────────────────────────────────
# https://us.posthog.com/project/{project}/settings/environment-variables
VITE_POSTHOG_KEY="your-ph-project-api-key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
